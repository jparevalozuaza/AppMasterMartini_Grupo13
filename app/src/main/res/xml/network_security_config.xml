<?xml version="1.0" encoding="utf-8"?>
<!--
    CONFIGURACIÓN DE SEGURIDAD DE RED
    Regla general: toda conexión debe ir cifrada (HTTPS).
    Excepción: el microservicio propio (Spring Boot) corre en el computador con HTTP,
    por eso solo se permite HTTP sin cifrar hacia esas direcciones locales.
-->
<network-security-config>

    <!-- Para cualquier otro servidor (por ejemplo, la API externa): solo HTTPS -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Únicas direcciones donde se permite HTTP: el backend local de desarrollo -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- 10.0.2.2 = "el computador" visto desde el emulador de Android -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Si se prueba en un celular físico, agregar aquí la IP local del computador,
             por ejemplo: <domain includeSubdomains="false">192.168.1.20</domain> -->
    </domain-config>

</network-security-config>
