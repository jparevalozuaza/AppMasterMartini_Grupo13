<?xml version="1.0" encoding="utf-8"?>
<!--
    REGLAS DE EXTRACCIÓN DE DATOS (Android 12 o superior)
    Se excluyen los datos de la app tanto del respaldo en la nube
    como de la transferencia directa a un teléfono nuevo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
