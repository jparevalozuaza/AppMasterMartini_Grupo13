<?xml version="1.0" encoding="utf-8"?>
<!--
    REGLAS DE RESPALDO (Android 11 o anterior)
    La app guarda datos de usuarios (Room), la sesión (DataStore) y fotos de perfil.
    Para que esos datos no salgan del teléfono en un respaldo, se excluye todo.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
